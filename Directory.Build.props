<Project>
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF Condition="'$(IsWpfProject)' == 'true'">true</UseWPF>
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <ContinuousIntegrationBuild Condition="'$(CI)' != ''">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>InkGuide</Company>
    <Product>InkGuide</Product>
    <Copyright>Copyright (c) InkGuide contributors</Copyright>
    <ApplicationId>inkguide.desktop</ApplicationId>
    <AppName>InkGuide</AppName>
  </PropertyGroup>
</Project>
