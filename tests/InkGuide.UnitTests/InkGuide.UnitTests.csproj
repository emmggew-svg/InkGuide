<Project Sdk="Microsoft.NET.Sdk">

  <!-- OS-version-pinned TFM: plain net9.0-windows infers TargetPlatformVersion 7.0,
       which trips NETSDK1135 against SupportedOSPlatformVersion 10.0.17763.0. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InkGuide.Domain\InkGuide.Domain.csproj" />
    <ProjectReference Include="..\..\src\InkGuide.Application\InkGuide.Application.csproj" />
    <ProjectReference Include="..\..\src\InkGuide.Analysis\InkGuide.Analysis.csproj" />
  </ItemGroup>

</Project>
