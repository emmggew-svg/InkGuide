<Project Sdk="Microsoft.NET.Sdk">

  <!-- OS-version-pinned TFM: plain net9.0-windows infers TargetPlatformVersion 7.0,
       which trips NETSDK1135 against SupportedOSPlatformVersion 10.0.17763.0. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkGuide.Domain\InkGuide.Domain.csproj" />
  </ItemGroup>

</Project>
