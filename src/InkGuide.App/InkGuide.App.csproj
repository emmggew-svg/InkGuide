<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- OS-version qualifier required: bare net9.0-windows defaults the
         target platform to 7.0, which conflicts with the repo-wide
         SupportedOSPlatformVersion 10.0.17763.0 (see docs/DECISIONS.md). -->
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <IsWpfProject>true</IsWpfProject>
    <!-- Set UseWPF directly: Directory.Build.props cannot observe IsWpfProject
         (it is imported before the project body defines it). -->
    <UseWPF>true</UseWPF>
    <!-- Required by LibraryImport source generation for Win32 activation (see DECISIONS.md). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Owner-supplied icon wins when present; otherwise the SDK default icon is used. No branding is created here. -->
    <ApplicationIcon Condition="Exists('..\..\assets\app.ico')">..\..\assets\app.ico</ApplicationIcon>
    <AssemblyName>InkGuide</AssemblyName>
    <RootNamespace>InkGuide.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkGuide.Bridge\InkGuide.Bridge.csproj" />
    <ProjectReference Include="..\InkGuide.Domain\InkGuide.Domain.csproj" />
    <ProjectReference Include="..\InkGuide.Application\InkGuide.Application.csproj" />
    <ProjectReference Include="..\InkGuide.Analysis\InkGuide.Analysis.csproj" />
    <ProjectReference Include="..\InkGuide.Infrastructure.Persistence\InkGuide.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\InkGuide.Infrastructure.Storage\InkGuide.Infrastructure.Storage.csproj" />
    <ProjectReference Include="..\InkGuide.Infrastructure.Platform\InkGuide.Infrastructure.Platform.csproj" />
  </ItemGroup>

  <!-- Dev convenience: `dotnet run` shows the reference UI without a full
       publish. Copies ui/dist next to the exe only when it exists, so clean
       checkouts without a UI build still compile. Skipped during publish:
       build\publish.cmd assembles ui\dist itself, and extra in-target copies
       disturb the publish file-resolution pipeline (MSB3094). -->
  <Target Name="CopyUiBundleForDev" AfterTargets="Build" Condition="Exists('..\..\ui\dist\index.html') And '$(PublishDir)' == ''">
    <ItemGroup>
      <UiBundleFiles Include="..\..\ui\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(UiBundleFiles)" DestinationFiles="@(UiBundleFiles->'$(OutDir)ui\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
